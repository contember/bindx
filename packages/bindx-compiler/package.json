{
	"name": "@contember/bindx-compiler",
	"version": "0.1.59",
	"description": "Build-time selection compiler for bindx: a Babel plugin and a Vite plugin that precompile implicit selections",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun run build:js && tsc --build",
		"build:js": "bun build src/index.ts --target=node --format=esm --packages=external --outdir=dist",
		"typecheck": "tsc --build",
		"test": "bun test tests/",
		"measure": "bun run scripts/measure.ts"
	},
	"dependencies": {
		"@babel/core": "^7.28.0",
		"@babel/parser": "^7.28.0",
		"@babel/types": "^7.28.0"
	},
	"peerDependencies": {
		"@contember/bindx-react": "workspace:*"
	},
	"devDependencies": {
		"@babel/plugin-transform-react-jsx": "^7.28.0",
		"@contember/bindx": "workspace:*",
		"@contember/bindx-react": "workspace:*",
		"@types/babel__core": "^7.20.5"
	},
	"files": [
		"dist",
		"src"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/contember/bindx.git",
		"directory": "packages/bindx-compiler"
	}
}
